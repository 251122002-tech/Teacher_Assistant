# PostgreSQL 16 connection string used by Prisma and the API (copy to .env; never commit .env)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teacher_assistant?schema=public"

# Secret for signing 15-minute access tokens (HS256). Use at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Optional settings
# API_PORT=3001
# Set to true when the site is served over HTTPS so the refresh cookie gets the Secure flag.
# COOKIE_SECURE=false
